{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "prices.schema.json",
 "title": "finsights.explore daily closes (public/data/prices/<MARKET>-<TICKER>.json)",
 "description": "Mirrors PriceSeries in src/types.ts. t and c have the same length (checked in code); t is ascending.",
 "type": "object",
 "additionalProperties": false,
 "required": ["k", "market", "cur", "t", "c"],
 "properties": {
  "k": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,11}$"},
  "market": {"enum": ["BIST", "US"]},
  "cur": {"enum": ["TRY", "USD"]},
  "t": {"type": "array", "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
  "c": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}}
 }
}
