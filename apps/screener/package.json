{
  "name": "fintools-screener",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm --prefix ../../shared test && npm run typecheck && npm test && npm run build",
    "deploy": "npm run check && npx wrangler deploy"
  },
  "dependencies": {
    "@fintools/shared": "file:../../shared"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
