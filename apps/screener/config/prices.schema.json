{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "prices.schema.json",
 "title": "finsights.explore daily closes (public/data/prices/<MARKET>-<TICKER>.json)",
 "description": "Mirrors PriceSeries in src/types.ts. dates and closes have the same length (checked in code); dates is ascending.",
 "type": "object",
 "additionalProperties": false,
 "required": ["symbol", "market", "currency", "dates", "closes"],
 "properties": {
  "symbol": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9.\\-]{0,11}$"},
  "market": {"enum": ["BIST", "US"]},
  "currency": {"enum": ["TRY", "USD"]},
  "dates": {"type": "array", "items": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}},
  "closes": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}}
 }
}
